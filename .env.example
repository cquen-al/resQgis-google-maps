# Direct Python connection; use a URL-encoded password in this URL.
DATABASE_URL=postgresql://resqgis:replace_with_password@localhost:5432/resqgis
# Docker Compose uses DB_PASSWORD to build its database connection.
DB_PASSWORD=replace_with_password
SECRET_KEY=replace_with_a_long_random_secret
SESSION_COOKIE_SECURE=false
PORT=8000

# One shared key for Maps JavaScript, Routes, Places API (New), and Geocoding.
# This key is visible in the browser. See GOOGLE_MAPS_SETUP.md for restrictions.
GOOGLE_MAPS_API_KEY=
# Development map ID; replace with your own JavaScript map ID for production.
GOOGLE_MAP_ID=DEMO_MAP_ID
GEOSERVER_WMS_URL=
GEOSERVER_LAYER=
